# Bags Shield App - Environment Variables Example
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# Feature Flags
HELIUS_ENABLED=true
RPC_FALLBACK_ENABLED=true
LOCAL_CACHE_ENABLED=true
JUPITER_SWAP_ENABLED=false
WALLET_CONNECT_ENABLED=true

# Helius Integration (Optimized with unstable_cache + dedupe)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_api_key_here
HELIUS_TIMEOUT_MS=6000
HELIUS_CACHE_TTL_S=300
HELIUS_MAX_CALLS_PER_SCAN=1
# Legacy (deprecated, use HELIUS_RPC_URL instead)
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_CLUSTER=mainnet

# Solana RPC
SOLANA_RPC_URL=https://solana.publicnode.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://solana.publicnode.com

# App Fees (Optional - OFF by default)
APP_FEE_ENABLED=false
APP_FEE_BPS=40
APP_FEE_WALLET_OPS=3Lwdox6RdkA8BDyxoVNUuvEDGn3rH5f51CzYVujcKxjB
APP_FEE_WALLET_TREASURY=CEHQL165RAytE3afmWfndkPuKCqBxcMRgZkiEC4tVriq
APP_FEE_PREFER_MINT=So11111111111111111111111111111111111111112
APP_FEE_FALLBACK_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Pro Scan (Optional - OFF by default)
PRO_SCAN_ENABLED=false
PRO_SCAN_LAMPORTS=100000
PRO_SCAN_VERIFY_ENABLED=true

# Webacy Integration (Optional - OFF by default)
WEBACY_ENABLED=0
WEBACY_API_KEY=your_webacy_api_key_here
WEBACY_BASE_URL=https://api.webacy.com
WEBACY_TIMEOUT_MS=10000
WEBACY_CACHE_TTL_MS=300000

# Backend API (Optional)
BAGS_SHIELD_API_BASE=
NEXT_PUBLIC_BAGS_SHIELD_API_BASE=

# Jupiter Aggregator (Optional)
JUPITER_API_BASE=https://api.jup.ag
JUPITER_API_BASE=https://api.jup.ag
